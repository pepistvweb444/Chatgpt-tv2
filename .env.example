# Jarvis backend/provider configuration
# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never commit real secrets.

# Public backend URL
JARVIS_PUBLIC_BASE_URL=https://chatgpt-tv2.vercel.app

# ===== AI PROVIDERS =====
# Primary (optional when alternatives are configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Alibaba Model Studio / Qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider routing preference. Jarvis should fall through on quota/credit/provider errors.
JARVIS_AI_PROVIDER_ORDER=openai,qwen,gemini,groq,openrouter

# ===== HOME CONNECT (Bosch / Siemens / NEFF / Gaggenau etc.) =====
HOMECONNECT_CLIENT_ID=
HOMECONNECT_CLIENT_SECRET=
HOMECONNECT_REDIRECT_URI=https://chatgpt-tv2.vercel.app/api/domotics/homeconnect/callback
HOMECONNECT_SCOPES=IdentifyAppliance Monitor Control Settings

# ===== SAMSUNG SMARTTHINGS =====
SMARTTHINGS_APP_ID=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=https://chatgpt-tv2.vercel.app/api/domotics/smartthings/callback
SMARTTHINGS_SCOPES=r:locations:* r:devices:* x:devices:*

# Optional temporary PAT for testing only; long-term use should use OAuth.
SMARTTHINGS_PAT=

# ===== PHILIPS HUE =====
# Used for Hue Remote API / OAuth. Local Hue Bridge pairing can additionally store a per-home application key at runtime.
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
HUE_REDIRECT_URI=https://chatgpt-tv2.vercel.app/api/domotics/hue/callback

# ===== TADO =====
# tado V3+/earlier uses the official public device-code client id in application code.
# Access/refresh tokens are user-specific runtime credentials and must NOT be committed as environment variables.
TADO_CLIENT_ID=1bb50063-6b0c-4d11-bd99-387f4a91cc46

# ===== SENSIBO =====
# Personal accounts: generate an API key in Sensibo account settings.
SENSIBO_API_KEY=

# Commercial Sensibo OAuth only (optional)
SENSIBO_CLIENT_ID=
SENSIBO_CLIENT_SECRET=
SENSIBO_REDIRECT_URI=https://chatgpt-tv2.vercel.app/api/domotics/sensibo/callback

# ===== ROBOROCK =====
# Do not paste Roborock account passwords in Vercel.
# Keep this disabled until Jarvis uses an official supported API/Open Platform or a dedicated authenticated bridge.
ROBOROCK_BRIDGE_URL=
ROBOROCK_BRIDGE_TOKEN=

# ===== OPTIONAL MCP / EXTERNAL CONNECTORS =====
# JSON array of remote HTTPS MCP server definitions when needed.
JARVIS_MCP_SERVERS_JSON=
