<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/chats" android:layout_width="48dp" android:layout_height="48dp" android:text="☰" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jarvis" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Companion" android:textColor="#6D7CFF" android:textSize="11sp" />
            </LinearLayout>
            <Button android:id="@+id/newChat" android:layout_width="48dp" android:layout_height="48dp" android:text="✎" />
            <Button android:id="@+id/connections" android:layout_width="48dp" android:layout_height="48dp" android:text="⋮" android:textSize="20sp" />
        </LinearLayout>

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Jarvis listo" android:textColor="#78D8FF" android:textSize="12sp" android:paddingStart="6dp" android:paddingTop="4dp" android:paddingBottom="6dp" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="74dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                <Button android:id="@+id/dayWidget" android:layout_width="142dp" android:layout_height="68dp" android:layout_marginEnd="8dp" android:text="✦ Resumen del día" android:textAllCaps="false" />
                <Button android:id="@+id/homeAutomation" android:layout_width="132dp" android:layout_height="68dp" android:layout_marginEnd="8dp" android:text="⌂ Domótica" android:textAllCaps="false" />
                <Button android:id="@+id/newsWidget" android:layout_width="120dp" android:layout_height="68dp" android:layout_marginEnd="8dp" android:text="▣ Noticias" android:textAllCaps="false" />
                <Button android:id="@+id/weatherWidget" android:layout_width="120dp" android:layout_height="68dp" android:text="☁ Tiempo" android:textAllCaps="false" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
                <TextView android:id="@+id/recentChats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buenos días. ¿En qué puedo ayudarte hoy?" android:textColor="#AAB3C2" android:textSize="14sp" android:padding="6dp" />
                <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F4F6FA" android:textSize="17sp" android:lineSpacingExtra="8dp" android:padding="8dp" />
            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView android:id="@+id/selectedToolsScroll" android:layout_width="match_parent" android:layout_height="42dp" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                <TextView android:id="@+id/selectedTools" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="ChatGPT   Home Assistant   Gmail   Maps" android:textColor="#C9D2E3" android:textSize="12sp" android:paddingHorizontal="10dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp">
            <Button android:id="@+id/tools" android:layout_width="52dp" android:layout_height="56dp" android:text="＋" android:textSize="22sp" />
            <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="7dp" android:hint="Pregunta lo que quieras…" android:textColor="#FFFFFF" android:textColorHint="#7F8795" android:background="#141821" android:paddingHorizontal="16dp" android:singleLine="true" />
            <Button android:id="@+id/mic" android:layout_width="52dp" android:layout_height="56dp" android:layout_marginStart="7dp" android:text="🎙" />
            <Button android:id="@+id/send" android:layout_width="52dp" android:layout_height="56dp" android:layout_marginStart="7dp" android:text="➤" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/sideMenu" android:layout_width="310dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0E1118" android:padding="18dp" android:visibility="gone" android:elevation="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JARVIS" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI COMPANION" android:textColor="#6D7CFF" android:textSize="12sp" android:paddingBottom="16dp" />
        <Button android:id="@+id/menuNewChat" android:layout_width="match_parent" android:layout_height="48dp" android:text="✎  Nuevo chat" android:textAllCaps="false" />
        <Button android:id="@+id/menuHistory" android:layout_width="match_parent" android:layout_height="48dp" android:text="▤  Chats" android:textAllCaps="false" />
        <Button android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="48dp" android:text="◉  Imágenes / Cámara" android:textAllCaps="false" />
        <Button android:id="@+id/files" android:layout_width="match_parent" android:layout_height="48dp" android:text="▣  Biblioteca / Archivos" android:textAllCaps="false" />
        <Button android:id="@+id/phoneControl" android:layout_width="match_parent" android:layout_height="48dp" android:text="⌘  Remote / Teléfono" android:textAllCaps="false" />
        <Button android:id="@+id/wakeWord" android:layout_width="match_parent" android:layout_height="48dp" android:text="◷  Programadas / Hola Jarvis" android:textAllCaps="false" />
        <Button android:id="@+id/menuPlugins" android:layout_width="match_parent" android:layout_height="48dp" android:text="⛓  Complementos" android:textAllCaps="false" />
        <Button android:id="@+id/voiceSettings" android:layout_width="match_parent" android:layout_height="48dp" android:text="🔊  Voz y ajustes" android:textAllCaps="false" />
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/menuRecents" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recientes\n\nTodavía no hay conversaciones" android:textColor="#C7CFDD" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>