<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080B10">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/chats" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/jarvis_input" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jarvis" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Companion" android:textColor="#617CFF" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/newChat" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="✎" android:textColor="#FFFFFF" android:textSize="21sp" android:background="@drawable/jarvis_input" />
            <TextView android:id="@+id/connections" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:gravity="center" android:text="⋮" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/jarvis_input" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Jarvis listo" android:textColor="#6FBFFF" android:textSize="12sp" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingBottom="7dp" />
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
                <LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="22dp" android:paddingBottom="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buenos días, Alberto" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:id="@+id/recentChats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¿En qué puedo ayudarte hoy?" android:textColor="#A5AFBE" android:textSize="14sp" android:paddingTop="4dp" android:paddingBottom="16dp" />
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="112dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
                        <TextView android:id="@+id/dayWidget" android:layout_width="160dp" android:layout_height="104dp" android:layout_marginEnd="10dp" android:gravity="center_vertical" android:background="@drawable/jarvis_card_purple" android:text="✦  Resumen del día\n\nResumen de tu día" android:textColor="#FFFFFF" android:textSize="15sp" />
                        <TextView android:id="@+id/homeAutomation" android:layout_width="160dp" android:layout_height="104dp" android:layout_marginEnd="10dp" android:gravity="center_vertical" android:background="@drawable/jarvis_card_green" android:text="⌂  Domótica\n\nControl de tu casa" android:textColor="#FFFFFF" android:textSize="15sp" />
                        <TextView android:id="@+id/newsWidget" android:layout_width="160dp" android:layout_height="104dp" android:layout_marginEnd="10dp" android:gravity="center_vertical" android:background="@drawable/jarvis_card_orange" android:text="▣  Noticias\n\nLo último importante" android:textColor="#FFFFFF" android:textSize="15sp" />
                        <TextView android:id="@+id/weatherWidget" android:layout_width="160dp" android:layout_height="104dp" android:gravity="center_vertical" android:background="@drawable/jarvis_card_blue" android:text="☁  Tiempo\n\nPrevisión local" android:textColor="#FFFFFF" android:textSize="15sp" />
                    </LinearLayout></HorizontalScrollView>
                </LinearLayout>
                <LinearLayout android:id="@+id/widgetHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="6dp" android:paddingBottom="12dp" />
                <LinearLayout android:id="@+id/conversationHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="20dp" />
            </LinearLayout>
        </ScrollView>
        <HorizontalScrollView android:id="@+id/selectedToolsScroll" android:layout_width="match_parent" android:layout_height="42dp" android:scrollbars="none" android:visibility="gone"><TextView android:id="@+id/selectedTools" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/jarvis_input" android:text="ChatGPT   Google Maps   Home Assistant   Gmail   Notion" android:textColor="#D4DBE7" android:textSize="12sp" /></HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="5dp">
            <TextView android:id="@+id/tools" android:layout_width="52dp" android:layout_height="56dp" android:gravity="center" android:text="＋" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/jarvis_input" />
            <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/jarvis_input" android:hint="Pregunta lo que quieras…" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#7F8795" />
            <TextView android:id="@+id/mic" android:layout_width="48dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:gravity="center" android:text="🎙" android:textColor="#FFFFFF" android:textSize="19sp" android:background="@drawable/jarvis_input" />
            <TextView android:id="@+id/send" android:layout_width="48dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:gravity="center" android:text="➤" android:textColor="#FFFFFF" android:textSize="21sp" android:background="@drawable/jarvis_card_purple" />
        </LinearLayout>
    </LinearLayout>
    <View android:id="@+id/drawerScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#AA000000" android:visibility="gone" />
    <LinearLayout android:id="@+id/sideMenu" android:layout_width="320dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B0E14" android:elevation="24dp" android:padding="18dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JARVIS" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI COMPANION" android:textColor="#617CFF" android:textSize="11sp" /></LinearLayout><TextView android:id="@+id/closeDrawer" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="✕" android:textColor="#FFFFFF" android:textSize="18sp" /></LinearLayout>
        <TextView android:id="@+id/menuNewChat" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="✎   Nuevo chat" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/menuHistory" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/jarvis_card_purple" android:text="▤   Chats" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="◉   Imágenes" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/files" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="▣   Biblioteca" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/menuDomotics" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="⌂   Domótica · dispositivos y estancias" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/phoneControl" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="⌘   Remote" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/wakeWord" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="◷   Programadas" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/menuPlugins" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="⛓   Complementos" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/voiceSettings" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="⚙   Ajustes" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="8dp" android:text="Recientes" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/menuRecents" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Todavía no hay conversaciones" android:textColor="#C3CBD8" android:textSize="14sp" android:lineSpacingExtra="7dp" /></ScrollView>
    </LinearLayout>
</FrameLayout>