<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp">
        <Button android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp" android:text="☰" android:textSize="20sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Jarvis" android:textSize="20sp" android:textStyle="bold" android:textColor="#111111" android:gravity="center" />
        <Button android:id="@+id/plugins" android:layout_width="48dp" android:layout_height="48dp" android:text="⊕" android:textSize="20sp" />
        <Button android:id="@+id/newChat" android:layout_width="48dp" android:layout_height="48dp" android:text="✎" android:textSize="20sp" />
    </LinearLayout>

    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● Listo" android:textColor="#777777" android:textSize="12sp" android:gravity="center" android:paddingBottom="4dp" />

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:paddingHorizontal="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/weatherCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:background="#EEF5FF">
                <TextView android:id="@+id/weatherIcon" android:layout_width="64dp" android:layout_height="64dp" android:text="☁️" android:textSize="36sp" android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                    <TextView android:id="@+id/weatherPlace" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiempo" android:textStyle="bold" android:textSize="15sp" android:textColor="#1B1B1B" />
                    <TextView android:id="@+id/weatherTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--°" android:textStyle="bold" android:textSize="30sp" android:textColor="#111111" />
                    <TextView android:id="@+id/weatherDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actualizando…" android:textSize="13sp" android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/weatherForecast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:padding="12dp" android:background="#F7F9FC" android:text="" android:textColor="#333333" android:textSize="13sp" />
            <com.jarvis.mobile.NowBriefView android:id="@+id/nowBrief" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:padding="14dp" android:background="#F5F5F5" android:text="Now Brief · pulsa para actualizar" android:textColor="#333333" android:textSize="14sp" />
            <LinearLayout android:id="@+id/widgetContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#161616" android:textSize="17sp" android:lineSpacingExtra="9dp" android:paddingBottom="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                <TextView android:id="@+id/phoneCard" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/visionCard" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none" android:paddingHorizontal="14dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/camera" android:layout_width="52dp" android:layout_height="44dp" android:text="📷" />
            <Button android:id="@+id/files" android:layout_width="52dp" android:layout_height="44dp" android:text="＋" />
            <Button android:id="@+id/voice" android:layout_width="70dp" android:layout_height="44dp" android:text="Voz" />
            <Button android:id="@+id/wake" android:layout_width="110dp" android:layout_height="44dp" android:text="Hola Jarvis" />
            <Button android:id="@+id/device" android:layout_width="95dp" android:layout_height="44dp" android:text="Teléfono" />
            <Button android:id="@+id/home" android:layout_width="100dp" android:layout_height="44dp" android:text="Domótica" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingBottom="12dp" android:paddingTop="8dp">
        <Button android:id="@+id/mic" android:layout_width="54dp" android:layout_height="58dp" android:text="🎤" />
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:hint="Mensaje a Jarvis" android:textColor="#1A1A1A" android:textColorHint="#8A8A8A" android:background="#F2F2F2" android:paddingHorizontal="18dp" android:maxLines="3" />
        <Button android:id="@+id/send" android:layout_width="58dp" android:layout_height="58dp" android:text="↑" android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
