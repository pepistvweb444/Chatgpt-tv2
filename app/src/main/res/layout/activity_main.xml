<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="48dp"
    android:background="#090B10">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="JARVIS TV" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v0.2 • Android TV" android:textColor="#72E6D1" android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="30dp"
        android:padding="28dp"
        android:background="#151922"
        android:text="Jarvis: Hola. Soy Jarvis TV v0.2. Puedes escribir con el mando o usar el micrófono."
        android:textColor="#F5F7FA"
        android:textSize="21sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical">
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:hint="Escribe un mensaje..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8A94A6"
            android:background="#202631"
            android:paddingHorizontal="20dp"
            android:singleLine="true" />
        <Button android:id="@+id/micButton" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginStart="12dp" android:text="MIC" />
        <Button android:id="@+id/sendButton" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginStart="12dp" android:text="ENVIAR" />
        <Button android:id="@+id/settingsButton" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginStart="12dp" android:text="AJUSTES" />
    </LinearLayout>
</LinearLayout>
