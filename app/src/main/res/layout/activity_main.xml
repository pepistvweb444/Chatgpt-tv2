<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chatsButton"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:text="☰"
                android:textSize="26sp"
                android:textAllCaps="false"
                android:nextFocusDown="@id/cardNow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:id="@+id/pageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jarvis"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Companion"
                    android:textColor="#617CFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/visionButton"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:text="◉"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="10dp"
                android:text="⋮"
                android:textSize="28sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Jarvis listo"
            android:textColor="#6FBFFF"
            android:textSize="13sp"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buenos días, Alberto"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:paddingTop="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿En qué puedo ayudarte hoy?"
                    android:textColor="#A5AFBE"
                    android:textSize="17sp"
                    android:paddingTop="3dp"
                    android:paddingBottom="18dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/cardNow"
                            android:layout_width="250dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_vertical"
                            android:padding="20dp"
                            android:background="#342A69"
                            android:text="✦  Resumen del día\n\nResumen de tu día"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/cardHome"
                            android:layout_width="250dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_vertical"
                            android:padding="20dp"
                            android:background="#174B3D"
                            android:text="⌂  Domótica\n\nControl de tu casa"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/cardMessages"
                            android:layout_width="250dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="12dp"
                            android:gravity="center_vertical"
                            android:padding="20dp"
                            android:background="#5A351C"
                            android:text="▣  Noticias\n\nLo último importante"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:focusable="true" />

                        <com.jarvis.tv.WeatherWidgetView
                            android:id="@+id/cardWeather"
                            android:layout_width="250dp"
                            android:layout_height="122dp"
                            android:gravity="center_vertical"
                            android:padding="20dp"
                            android:background="#233F8B"
                            android:text="☁  Tiempo\n\nPrevisión local"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/currentChatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo chat"
                    android:textColor="#A9B2C2"
                    android:textSize="14sp"
                    android:paddingTop="18dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="220dp"
                    android:padding="18dp"
                    android:background="#10141C"
                    android:text=""
                    android:textColor="#F4F6FA"
                    android:textSize="19sp"
                    android:lineSpacingExtra="7dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <TextView android:layout_width="160dp" android:layout_height="match_parent" android:gravity="center" android:background="#191C2C" android:text="ChatGPT" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="190dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="#14231F" android:text="Home Assistant" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="130dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="#1C202A" android:text="Gmail" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="145dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:background="#1C202A" android:text="Maps" android:textColor="#FFFFFF" android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="7dp">

            <Button
                android:id="@+id/assistantBubble"
                android:layout_width="62dp"
                android:layout_height="58dp"
                android:text="＋"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="Pregunta lo que quieras…"
                android:textColor="#FFFFFF"
                android:textColorHint="#7E8797"
                android:background="#171B24"
                android:paddingHorizontal="20dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/micButton"
                android:layout_width="62dp"
                android:layout_height="58dp"
                android:layout_marginStart="10dp"
                android:text="🎙"
                android:textSize="19sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="92dp"
                android:layout_height="58dp"
                android:layout_marginStart="10dp"
                android:text="➤"
                android:textSize="22sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tvSideMenu"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0E14"
        android:elevation="28dp"
        android:padding="24dp"
        android:visibility="gone">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JARVIS" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI COMPANION" android:textColor="#617CFF" android:textSize="12sp" android:paddingBottom="18dp" />

        <Button android:id="@+id/homeButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="✎  Nuevo chat" android:textAllCaps="false" />
        <Button android:id="@+id/chatButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="✦  Chat" android:textAllCaps="false" />
        <Button android:id="@+id/connectionsButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="⛓  Complementos" android:textAllCaps="false" />
        <Button android:id="@+id/homeControlButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="⌂  Domótica" android:textAllCaps="false" />
        <Button android:id="@+id/routinesButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="◷  Programadas" android:textAllCaps="false" />
        <Button android:id="@+id/notificationsButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="●  Avisos / mensajes" android:textAllCaps="false" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recientes" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="10dp" />
        <TextView android:id="@+id/cardRoutine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chats recientes desde ☰" android:textColor="#A9B2C2" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>